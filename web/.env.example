# Public API origin — used by browser-side code and as the server-side
# fallback in local dev.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DNS-only origin for the same API, used only by server-side code running in
# the Cloudflare Worker (see wrangler.jsonc for why). Leave unset locally —
# src/lib/api/public.ts falls back to NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=
