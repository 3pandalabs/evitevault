# Postgres. In prod this is the internal connection string for the `evitevault`
# database on the shared 3pandalabs-postgres instance, as the `evitevault_app`
# role. Locally it's docker-compose.dev.yml — note port 5433, so it doesn't
# clash with a RentVault/ReceiptCash Postgres already on 5432.
DATABASE_URL=postgres://evitevault:evitevault@localhost:5433/evitevault

# Privileged DDL role used ONLY by db/migrate.ts. LEAVE THIS UNSET — there is
# no role split; evitevault_app owns its own database. Setting it to a
# superuser creates objects the runtime role can't read (42501).
# MIGRATION_DATABASE_URL=

# HTTP server
PORT=8080

# JWT access-token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated CORS origins (web app + local dev)
CORS_ORIGINS=http://localhost:3000,https://rsvpvault.3pandalabs.com

# Where the public invitation lives. Used to build the links in announcement
# emails and the URL field of generated .ics files.
WEB_ORIGIN=http://localhost:3000

# Salt for the event_views visitor hash. REQUIRED — without it the API refuses
# to boot rather than storing a reversible digest of visitor IPs.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=changeme

# Cloudflare R2 (S3-compatible). Buckets must exist first — see infra/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=evitevault-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Bearer token for the ops-only GET /metrics endpoint scraped by the admin page.
# Must match the METRICS_TOKEN secret on the 3pandalabs-admin Worker (one shared
# token across all apps). Leave blank to disable — /metrics then answers 503 and
# nothing else changes.
METRICS_TOKEN=

# Outbound email goes through the shared org gateway (3pandalabs/mailer), a
# Cloudflare Worker using the send_email binding. There is deliberately NO
# Cloudflare API token here: the binding authenticates implicitly, so no
# provider credential exists in this app's environment at all.
#
# MAILER_TOKEN grants exactly one capability — send as evitevault's configured
# sender address, which lives in the gateway's APP_SENDERS (not here, so it
# can't drift). Both optional: unset means sends are logged and counted as
# skipped rather than throwing.
MAILER_URL=https://mailer.3pandalabs.com
MAILER_TOKEN=
EMAIL_FROM_NAME=RsvpVault

# Inbox the public contact form (POST /contact) relays to. Optional; defaults
# to the org support mailbox the privacy policy publishes.
# SUPPORT_EMAIL=support@3pandalabs.com


# Cash gifts (lib/gifts). Off unless CASH_GIFTS=on (or =admins). Stripe TEST
# for every host unless GIFTS_STRIPE_MODE=live (then real hosts use
# STRIPE_SECRET_KEY; admins testing as host and test hosts stay on TEST).
# CASH_GIFTS=off
# GIFTS_STRIPE_MODE=test
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# GIFT_MIN_CENTS=500
# GIFT_MAX_CENTS=50000
# GIFT_EVENT_DAILY_CAP_CENTS=200000
# GIFT_EVENT_CAP_CENTS=500000
# GIFT_PLATFORM_FEE_BPS=150
# GIFTS_STRIPE_ACCOUNTS_API=v2
