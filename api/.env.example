# Postgres. In prod this is the internal connection string for the `evitevault`
# database on the shared 3pandalabs-postgres instance, as the `evitevault_app`
# role. Locally it's docker-compose.dev.yml — note port 5433, so it doesn't
# clash with a RentVault/ReceiptCash Postgres already on 5432.
DATABASE_URL=postgres://evitevault:evitevault@localhost:5433/evitevault

# Privileged DDL role used ONLY by db/migrate.ts. LEAVE THIS UNSET — there is
# no role split; evitevault_app owns its own database. Setting it to a
# superuser creates objects the runtime role can't read (42501).
# MIGRATION_DATABASE_URL=

# HTTP server
PORT=8080

# JWT access-token signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated CORS origins (web app + local dev)
CORS_ORIGINS=http://localhost:3000,https://evitevault.3pandalabs.com

# Where the public invitation lives. Used to build the links in announcement
# emails and the URL field of generated .ics files.
WEB_ORIGIN=http://localhost:3000

# Salt for the event_views visitor hash. REQUIRED — without it the API refuses
# to boot rather than storing a reversible digest of visitor IPs.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=changeme

# Cloudflare R2 (S3-compatible). Buckets must exist first — see infra/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=evitevault-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Bearer token for the ops-only GET /metrics endpoint scraped by the admin page.
# Must match the METRICS_TOKEN secret on the 3pandalabs-admin Worker (one shared
# token across all apps). Leave blank to disable — /metrics then answers 503 and
# nothing else changes.
METRICS_TOKEN=

# Outbound email — Cloudflare Email Sending, via its REST API (this is a Node
# process, not a Worker, so the send_email binding isn't available).
#
# All optional. With any unset, sends are logged and counted as skipped instead
# of throwing: guests are already saved by that point, and losing a host's guest
# list because an ops secret is missing is a far worse failure than an
# undelivered invitation.
#
# Two prerequisites, both dashboard/CLI steps:
#   1. Onboard the sending domain:  npx wrangler email sending enable 3pandalabs.com
#   2. Create a Cloudflare API token with the email sending permission.
EMAIL_FROM=invitations@3pandalabs.com
EMAIL_FROM_NAME=EviteVault
EMAIL_ACCOUNT_ID=f688cc57abfb9e1ef72a57f4841e0e73
EMAIL_API_TOKEN=
